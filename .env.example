# ===========================================
# XEROVA - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# --- Authentication (Auth.js) ---
AUTH_SECRET=  # Generate with: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# --- Database ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/xerova?retryWrites=true&w=majority

# --- AI ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Threat Intelligence APIs ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
CRIMINAL_IP_API_KEY=
ABUSIX_API_KEY=
OTX_API_KEY=
ALPHA_MOUNTAIN_API=
THREATYETI_API_KEY=
URL_QUERY_API_KEY=
YANDEX_API_KEY=
IP2LOCATION_API_KEY=
IP2WHOIS_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
