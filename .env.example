# ===========================================
# XEROVA - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# --- Authentication (Auth.js) ---
AUTH_SECRET=  # Generate with: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# --- Database ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/xerova?retryWrites=true&w=majority

# --- AI ---
GROQ_API_KEY=  # Default ultra-fast reasoning engine
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=  # Fallback AI engine
OPENAI_API_KEY=

# --- Threat Intelligence & Security APIs ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
CRIMINAL_IP_API_KEY=
ABUSIX_API_KEY=
OTX_API_KEY=
ALPHA_MOUNTAIN_API=
THREATYETI_API_KEY=
ENABLE_ALPHA_MOUNTAIN=false  # Set to true only when you want alphaMountain outputs enabled
URL_QUERY_API_KEY=
YANDEX_API_KEY=
IP2LOCATION_API_KEY=
IP2WHOIS_API_KEY=
IPSTACK_API_KEY=
MAILBOXLAYER_API_KEY=
PHISHSTATS_API_KEY=
URLSCAN_IO_API_KEY=
CHECKPHISH_API_KEY=
CLOUDMERSIVE_API_KEY=

# --- App & Email Verification ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Gmail API (Email Verification Service) ---
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

